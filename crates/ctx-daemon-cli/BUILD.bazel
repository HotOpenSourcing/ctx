    name = "qualification_test_support_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_daemon_cli",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_DAEMON_CLI_QUALIFICATION_TEST_SUPPORT_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_daemon_cli",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + CTX_DAEMON_CLI_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
)
