load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")
load("//tools/bazel:gates.bzl", "loc_check_inputs")

package(default_visibility = ["//visibility:public"])

loc_check_inputs(name = "loc_check_inputs")

exports_files(["BUILD.bazel", "Cargo.toml"])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

COMMON_RUSTC_ENV = {"CARGO_MANIFEST_DIR": "crates/ctx-pro-lifecycle"}
RUST_SRCS = glob(["src/**/*.rs"])
PROD_SRCS = glob(["src/**/*.rs"], exclude = RUST_PROD_SRC_EXCLUDES)
LIFECYCLE_DEPS = [
    "//crates/ctx-history-core:lib",
    "//crates/ctx-pro-access:lib",
    "//crates/ctx-pro-host-protocol:lib",
]
LIFECYCLE_RUSTC_FLAGS = [
    '--check-cfg=cfg(feature, values("test-support"))',
    "--check-cfg=cfg(test)",
]

LIFECYCLE_TEST_DEPS = [
    "//crates/ctx-history-core:lib",
    "//crates/ctx-pro-access:test_support_lib",
    "//crates/ctx-pro-host-protocol:lib",
]

LIFECYCLE_QUALIFICATION_DEPS = [
    "//crates/ctx-history-core:lib",
    "//crates/ctx-pro-access:qualification_lib",
    "//crates/ctx-pro-host-protocol:lib",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_pro_lifecycle",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + LIFECYCLE_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = LIFECYCLE_RUSTC_FLAGS,
)

rust_library(
    name = "test_support_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_pro_lifecycle",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + LIFECYCLE_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = LIFECYCLE_RUSTC_FLAGS + ['--cfg=feature="test-support"'],
)

# Bazel does not unify Cargo features across a dependency graph. These
# test-only variants keep lifecycle's ctx-pro-access identity aligned with the
# optimized qualification hosts while preserving one production :lib path.
rust_library(
    name = "qualification_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_pro_lifecycle",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + LIFECYCLE_QUALIFICATION_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = LIFECYCLE_RUSTC_FLAGS,
)

rust_library(
    name = "qualification_test_support_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_pro_lifecycle",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + LIFECYCLE_QUALIFICATION_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = LIFECYCLE_RUSTC_FLAGS + ['--cfg=feature="test-support"'],
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_pro_lifecycle",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    compile_data = ["//:release_contracts"],
    deps = all_crate_deps(normal = True, normal_dev = True) + LIFECYCLE_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = LIFECYCLE_RUSTC_FLAGS,
)
